<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.pinterest.drsquirrel</groupId>
  <artifactId>drsquirrel-java</artifactId>
  <version>1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>drsquirrel-java</name>
  <url>http://maven.apache.org</url>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.source>8</maven.compiler.source>
    <maven.compiler.target>8</maven.compiler.target>
    <arrow.version>12.0.0</arrow.version>
  </properties>

  <dependencies>
    <!-- Depend on JNI + Thrift converter API moved to surfingthriftjni subproject -->
    <dependency>
      <groupId>com.pinterest.surfing</groupId>
      <artifactId>surfingthriftjni</artifactId>
      <version>1.0-SNAPSHOT</version>
    </dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>3.8.1</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-lang3</artifactId>
      <version>3.12.0</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>2.14.2</version>
    </dependency>
    <!-- https://mvnrepository.com/artifact/com.fasterxml.jackson.core/jackson-core -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-core</artifactId>
      <version>2.14.2</version>
    </dependency>
    <dependency>
      <groupId>io.airlift</groupId>
      <artifactId>units</artifactId>
      <version>1.6</version>
    </dependency>
    <dependency>
      <groupId>com.google.guava</groupId>
      <artifactId>guava</artifactId>
      <version>13.0.1</version>
    </dependency>
    <dependency>
      <groupId>org.apache.arrow</groupId>
      <artifactId>arrow-c-data</artifactId>
      <version>${arrow.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.arrow</groupId>
      <artifactId>arrow-vector</artifactId>
      <version>${arrow.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.arrow</groupId>
      <artifactId>arrow-memory-core</artifactId>
      <version>${arrow.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.arrow</groupId>
      <artifactId>arrow-memory-netty</artifactId>
      <version>${arrow.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.arrow</groupId>
      <artifactId>arrow-format</artifactId>
      <version>${arrow.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.flink</groupId>
      <artifactId>flink-core</artifactId>
      <version>1.16.0</version>
    </dependency>
    <dependency>
      <groupId>org.apache.flink</groupId>
      <artifactId>flink-streaming-java</artifactId>
      <version>1.16.0</version>
    </dependency>
    <dependency>
      <groupId>org.apache.flink</groupId>
      <artifactId>flink-runtime</artifactId>
      <version>1.16.0</version>
    </dependency>
    <dependency>
      <groupId>com.tdunning</groupId>
      <artifactId>t-digest</artifactId>
      <version>3.2</version>
    </dependency>
    <!-- Kafka client for Java-native consumer path -->
    <dependency>
      <groupId>org.apache.kafka</groupId>
      <artifactId>kafka-clients</artifactId>
      <version>3.6.1</version>
    </dependency>
    <!-- Apache Thrift for Java deserialization -->
    <dependency>
      <groupId>org.apache.thrift</groupId>
      <artifactId>libthrift</artifactId>
      <version>0.13.0</version>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.4</version>
        <configuration>
          <argLine>${gc.args}</argLine>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-assembly-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>single</goal>
            </goals>
            <configuration>
              <descriptorRefs>
                <descriptorRef>jar-with-dependencies</descriptorRef>
              </descriptorRefs>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>gc-finetune</id>
      <properties>
        <!-- GC tuning and logging; JVM8-compatible flags -->
        <gc.args>-XX:+UseG1GC -XX:+ExplicitGCInvokesConcurrent -XX:+UseStringDeduplication -XX:MaxGCPauseMillis=200 -XX:InitiatingHeapOccupancyPercent=30 -XX:MaxTenuringThreshold=8 -XX:+PrintGC -XX:+PrintGCDetails -XX:+PrintGCDateStamps -Xloggc:${project.build.directory}/gc.log -XX:MaxDirectMemorySize=1024m -Xms512m -Xmx2g</gc.args>
      </properties>
    </profile>
    <profile>
      <id>jni-load</id>
      <properties>
        <np>4</np>
        <mode></mode>
        <rows>200000</rows>
        <iters>3</iters>
        <iface></iface>
        <out>${project.build.directory}/jni_shuffle_load.csv</out>
        <java.library.path>${project.basedir}/../build</java.library.path>
        <fat.jar>${project.build.directory}/${project.artifactId}-${project.version}-jar-with-dependencies.jar</fat.jar>
      </properties>
      <build>
        <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>deep-gen</id>
            <phase>verify</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <mainClass>com.pinterest.drsquirrel.bench.DeepEventGenerator</mainClass>
              <arguments>
                <argument>${project.build.directory}/deep_payloads.bin</argument>
                <argument>20000</argument>
              </arguments>
            </configuration>
          </execution>
              <execution>
                <id>run-jni-load</id>
                <phase>verify</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <!-- Wrap in bash to force success even if mpiexec returns non-zero in noisy environments -->
                  <executable>bash</executable>
                  <arguments>
                    <argument>-lc</argument>
                    <argument>
                      <![CDATA[
set -eo pipefail; \
export LD_LIBRARY_PATH="${java.library.path}:${LD_LIBRARY_PATH:-}"; \
IFACE_OPT=""; \
if [ -n "${iface}" ]; then IFACE_OPT="--mca btl_tcp_if_include ${iface}"; else IFACE_OPT="--mca btl_tcp_if_exclude lo,docker0"; fi; \
mpiexec -np ${np} --use-hwthread-cpus --oversubscribe --map-by core --bind-to core \
  ${IFACE_OPT} \
  java  -Djava.library.path= -cp  \
  com.pinterest.drsquirrel.jni.JniShuffleLoadRunner ${mode} || true
                      ]]>
                    </argument>
                  </arguments>
                  <environmentVariables>
                    <SHUFFLE_LOAD_ROWS>${rows}</SHUFFLE_LOAD_ROWS>
                    <SHUFFLE_LOAD_ITERS>${iters}</SHUFFLE_LOAD_ITERS>
                    <SHUFFLE_LOAD_OUT>${out}</SHUFFLE_LOAD_OUT>
                  </environmentVariables>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <id>jni-nested</id>
      <properties>
        <np>4</np>
        <mode></mode>
        <iface></iface>
        <java.library.path>${project.basedir}/../build</java.library.path>
        <fat.jar>${project.build.directory}/${project.artifactId}-${project.version}-jar-with-dependencies.jar</fat.jar>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.5.0</version>
            <executions>
              <execution>
                <id>run-jni-nested</id>
                <phase>verify</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>bash</executable>
                  <arguments>
                    <argument>-lc</argument>
                    <argument>
                      <![CDATA[
set -eo pipefail; 
export LD_LIBRARY_PATH="${java.library.path}:${LD_LIBRARY_PATH:-}"; 
IFACE_OPT=""; 
if [ -n "${iface}" ]; then IFACE_OPT="--mca btl_tcp_if_include ${iface}"; else IFACE_OPT="--mca btl_tcp_if_exclude lo,docker0"; fi; 
mpiexec -np ${np} --use-hwthread-cpus --oversubscribe --map-by core --bind-to core \
  ${IFACE_OPT} \
  java  -Djava.library.path= -cp  \
  com.pinterest.drsquirrel.jni.JniNestedRunner ${mode} || true
                      ]]>
                    </argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <id>jni-cogroup-load</id>
      <properties>
        <np>4</np>
        <mode></mode>
        <rows>200000</rows>
        <iters>3</iters>
        <iface></iface>
        <out>${project.build.directory}/jni_cogroup_load.csv</out>
        <java.library.path>${project.basedir}/../build</java.library.path>
        <fat.jar>${project.build.directory}/${project.artifactId}-${project.version}-jar-with-dependencies.jar</fat.jar>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.5.0</version>
            <executions>
              <execution>
                <id>run-jni-cogroup-load</id>
                <phase>verify</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>bash</executable>
                  <arguments>
                    <argument>-lc</argument>
                    <argument>
                      <![CDATA[
set -eo pipefail; \
export LD_LIBRARY_PATH="${java.library.path}:${LD_LIBRARY_PATH:-}"; \
IFACE_OPT=""; \
if [ -n "${iface}" ]; then IFACE_OPT="--mca btl_tcp_if_include ${iface}"; else IFACE_OPT="--mca btl_tcp_if_exclude lo,docker0"; fi; \
mpiexec -np ${np} --use-hwthread-cpus --oversubscribe --map-by core --bind-to core \
  ${IFACE_OPT} \
  java  -Djava.library.path= -cp  \
  com.pinterest.drsquirrel.jni.JniCogroupLoadRunner ${mode} || true
                      ]]>
                    </argument>
                  </arguments>
                  <environmentVariables>
                    <SHUFFLE_LOAD_ROWS>${rows}</SHUFFLE_LOAD_ROWS>
                    <SHUFFLE_LOAD_ITERS>${iters}</SHUFFLE_LOAD_ITERS>
                    <SHUFFLE_LOAD_OUT>${out}</SHUFFLE_LOAD_OUT>
                  </environmentVariables>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <id>jni-all-load</id>
      <properties>
        <rows>200000</rows>
        <iters>1</iters>
        <iface></iface>
        <outDir>${project.basedir}/../build</outDir>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.5.0</version>
            <executions>
              <execution>
                <id>run-all-load</id>
                <phase>verify</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>bash</executable>
                  <arguments>
                    <argument>-lc</argument>
                    <argument>
                      <![CDATA[
set -eo pipefail; \
export SHUFFLE_LOAD_ROWS=${rows}; \
export SHUFFLE_LOAD_ITERS=${iters}; \
export IFACE=${iface}; \
export OUT_DIR=${outDir}; \
./scripts/run_all_load_all_cores.sh || true
                      ]]>
                    </argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
